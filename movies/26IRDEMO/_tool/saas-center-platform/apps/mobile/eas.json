{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "API_URL": "https://api.staging.mindscope.kr"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_URL": "https://api.mindscope.kr"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "jhjzzang14@gmail.com",
        "ascAppId": "6760991252",
        "appleTeamId": "DT5U6KPA73"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "appleId": "jhjzzang14@gmail.com",
        "ascAppId": "6760991252",
        "appleTeamId": "DT5U6KPA73"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
