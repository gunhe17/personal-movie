{
	"name": "web",
	"private": true,
	"version": "1.7.2",
	"type": "module",
	"scripts": {
		"planning:dev": "node tools/planning-pilot/server.mjs",
		"planning:check": "cd tools/planning-pilot && npm run check",
		"planning:test": "cd tools/planning-pilot && npm run test",
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"deploy": "bash scripts/deploy.sh",
		"start:prod": "NODE_ENV=production node build/index.js",
		"start:pm2": "pm2 start ecosystem.config.cjs --env production",
		"stop:pm2": "pm2 stop imomtae-saas",
		"restart:pm2": "pm2 restart imomtae-saas",
		"logs:pm2": "pm2 logs imomtae-saas",
		"monit:pm2": "pm2 monit",
		"changelog": "bash scripts/generate-changelog.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^24.5.2",
		"@vitest/browser": "^3.2.3",
		"@vitest/coverage-v8": "3.2.4",
		"playwright": "^1.53.0",
		"prettier": "3.4.2",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4",
		"vitest": "^3.2.3",
		"vitest-browser-svelte": "^0.1.0"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.0.5",
		"@types/base-64": "^1.0.2",
		"axios": "^1.11.0",
		"base-64": "^1.0.0",
		"chart.js": "^4.5.1",
		"clsx": "^2.1.1",
		"firebase": "^12.10.0",
		"pdfjs-dist": "^5.4.530",
		"svelte-motion": "^0.12.2",
		"tailwind-merge": "^3.3.1",
		"xlsx": "^0.18.5"
	}
}
