# ===========================================
# MindBom Production Environment Variables
# Copy to .env.production and fill in values
# ===========================================

# --- Domain ---
FRONTEND_URL=https://mindbom.kr

# --- Database ---
DB_USER=mindbom
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=mindbom

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI Service ---
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=
AI_SCT_SCORE_URL=
AI_INTERPRETATION_URL=
AI_RORSCHACH_SCORE_URL=

# --- S3 Storage ---
STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- SMTP ---
SMTP_SERVER=
SMTP_PORT=587
HOST_EMAIL=
HOST_PASSWORD=

# --- OpenAI (optional) ---
OPENAI_API_KEY=
