# MindBom API Environment Variables
DATABASE_URL=postgresql+asyncpg://mindbom:mindbom_dev@localhost:5432/mindbom
JWT_SECRET_KEY=mindbom-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_ENV=development
DEBUG=true

# AI Service (sLLM)
AI_SERVICE_URL=http://localhost:8100
AI_SERVICE_ENABLED=false

# 통합 보고서 요약 LLM (OpenRouter 경유 Gemini Flash)
# 비어있으면 룰베이스 폴백. AI팀 서버 쓰면 AI_REPORT_SUMMARIZE_URL 우선.
# 키는 아래 OPENROUTER_API_KEY 사용.
AI_REPORT_BASE_URL=https://openrouter.ai/api/v1
AI_REPORT_MODEL=google/gemini-2.5-flash

# File Storage
STORAGE_PATH=/tmp/mindbom-storage

# Audit Trail (GMP)
AUDIT_ENABLED=true

# Frontend
FRONTEND_URL=http://localhost:4503

OPENAI_API_KEY=...
OPENROUTER_API_KEY=...

# SMTP Email
SMTP_SERVER=...
SMTP_PORT=...
HOST_EMAIL=...
HOST_PASSWORD=...
